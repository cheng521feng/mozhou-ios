/* ==========================================================================
   墨舟移动端 · 动效与手感层  fx.css  v5
   和 style.css 一起用：style.css 负责「长什么样」，fx.css 负责「怎么动」。

   约定：
   · 进度环 = 用 @property 注册的 --p（0~100）驱动 conic-gradient，只改一个数字
     就能平滑转圈，比 SVG stroke-dasharray 省钱，iOS 16.4+ 原生支持。
   · 入场序号 = --i，卡片/列表按序号错峰浮上来。
   · 全部动效都尊重 prefers-reduced-motion，开了「减弱动态效果」就退化成立即到位。
   ========================================================================== */

@property --p { syntax: '<number>'; inherits: false; initial-value: 0; }
@property --ang { syntax: '<angle>'; inherits: false; initial-value: 0deg; }
@property --glow { syntax: '<number>'; inherits: false; initial-value: 0; }

/* ============================== 关键帧 ============================== */
@keyframes mzAurora {
  0%   { transform: translate3d(0,0,0) scale(1); }
  50%  { transform: translate3d(-2.5%, 2%, 0) scale(1.07); }
  100% { transform: translate3d(0,0,0) scale(1); }
}
@keyframes mzRise {
  from { opacity: 0; transform: translate3d(0, 16px, 0) scale(.982); }
  to   { opacity: 1; transform: none; }
}
@keyframes mzPop {
  0%   { opacity: 0; transform: scale(.86); }
  62%  { opacity: 1; transform: scale(1.035); }
  100% { opacity: 1; transform: scale(1); }
}
@keyframes mzFade { from { opacity: 0; } to { opacity: 1; } }
@keyframes mzPushIn  { from { opacity: 0; transform: translate3d(26px,0,0) scale(.988); } to { opacity: 1; transform: none; } }
@keyframes mzBackIn  { from { opacity: 0; transform: translate3d(-22px,0,0) scale(.99); } to { opacity: 1; transform: none; } }
@keyframes mzSpin { to { transform: rotate(360deg); } }
@keyframes mzShimmer { from { background-position: -180% 0; } to { background-position: 180% 0; } }
@keyframes mzPulse {
  0%   { transform: scale(1);   opacity: 1; }
  70%  { transform: scale(2.6); opacity: 0; }
  100% { transform: scale(2.6); opacity: 0; }
}
@keyframes mzBreath { 0%,100% { transform: scale(1); } 50% { transform: scale(1.045); } }
@keyframes mzSlideDown { from { opacity: 0; transform: translate3d(0,-120%,0); } to { opacity: 1; transform: none; } }
@keyframes mzMarquee { from { transform: translate3d(0,0,0); } to { transform: translate3d(-50%,0,0); } }
@keyframes mzInk { to { transform: scale(1); opacity: 0; } }
@keyframes mzStripe { from { background-position: 0 0; } to { background-position: 34px 0; } }
@keyframes mzSpark {
  0%   { opacity: 0; transform: translate3d(0,6px,0) scale(.7); }
  40%  { opacity: 1; }
  100% { opacity: 0; transform: translate3d(0,-14px,0) scale(1.05); }
}
@keyframes mzBlink { 0%,100% { opacity: 1; } 50% { opacity: .25; } }

/* ============================== 入场 ============================== */
.rise { animation: mzRise .52s var(--spring) both; animation-delay: calc(var(--i, 0) * 44ms); }
.rise.late { animation-delay: calc(120ms + var(--i, 0) * 44ms); }

/* 首次渲染：卡片错峰浮上来，列表行轻微跟手 */
.list.rise-list > .li { animation: mzRise .46s var(--spring) both; animation-delay: calc(var(--i, 0) * 30ms); }

/* 页签切换 / 推入式页面的转场 */
.screen-fade { animation: mzFade .28s ease both; }
.screen-push { animation: mzPushIn .34s var(--spring) both; }
.screen-back { animation: mzBackIn .3s var(--spring) both; }

/* 通用出现/消失 */
.on   { }
.gone { opacity: 0 !important; transform: translate3d(0, 8px, 0) scale(.985); transition: opacity .34s ease, transform .34s ease; pointer-events: none; }

/* 点击回弹：按钮 / 可点行 */
.btn, .tab, .as-item, .li.tap, .chip.tapable {
  transition: transform .16s var(--spring), opacity .16s ease, background-color .2s ease, box-shadow .24s ease;
}
.btn:active, .as-item:active { transform: scale(.965); }
.li.tap:active { background: var(--press, rgba(255,255,255,.05)); }
.li.tap:active .li-title { transform: translate3d(1px,0,0); }

/* 点击涟漪 */
.ripple {
  position: absolute; border-radius: 999px; pointer-events: none;
  background: radial-gradient(circle, rgba(255,255,255,.34), rgba(255,255,255,0) 68%);
  transform: scale(.2); opacity: .75; animation: mzInk .62s ease-out forwards;
}
html.light .ripple { background: radial-gradient(circle, rgba(20,40,70,.2), rgba(20,40,70,0) 68%); }

/* ============================== 加载 ============================== */
.spinner {
  width: 22px; height: 22px; border-radius: 999px; display: inline-block;
  border: 2.2px solid color-mix(in srgb, var(--accent) 28%, transparent);
  border-top-color: var(--accent);
  animation: mzSpin .78s linear infinite;
}
.spinner.lg { width: 34px; height: 34px; border-width: 3px; }
.spinner.sm { width: 15px; height: 15px; border-width: 1.9px; }

/* 骨架屏：把「加载中」变成内容形状，比一个转圈更有期待感 */
.skel-card { padding: 16px 15px; border-radius: var(--r-card); background: var(--panel); border: 1px solid var(--line); }
.skel-card + .skel-card { margin-top: 12px; }
.skel-line {
  height: 12px; border-radius: 8px; margin-bottom: 11px;
  background: linear-gradient(100deg, var(--skel-a) 22%, var(--skel-b) 46%, var(--skel-a) 70%);
  background-size: 220% 100%; animation: mzShimmer 1.35s linear infinite;
}
.skel-line:nth-child(2) { width: 78%; }
.skel-line:nth-child(3) { width: 56%; }
.skel-line:last-child { margin-bottom: 0; width: 40%; }

/* 顶部细进度条（切页 / 请求时挂上去） */
.topline {
  position: fixed; left: 0; top: 0; height: 2.5px; width: 100%; z-index: 60;
  transform-origin: 0 50%; transform: scaleX(0); opacity: 0;
  background: linear-gradient(90deg, var(--accent), var(--accent2), var(--accent));
  transition: transform .32s ease, opacity .3s ease;
}
.topline.on { opacity: 1; }
.topline::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,.6), transparent);
  animation: mzMarquee 1.1s linear infinite;
}

/* ============================== Toast ============================== */
.toasts {
  position: fixed; left: 0; right: 0; z-index: 70;
  top: calc(var(--safe-t) + 6px);
  display: flex; flex-direction: column; align-items: center; gap: 8px;
  pointer-events: none; padding: 0 12px;
}
.toast {
  pointer-events: auto; max-width: 92vw;
  display: flex; align-items: center; gap: 9px;
  padding: 11px 14px; border-radius: 15px;
  background: var(--toast-bg); border: 1px solid var(--toast-line);
  color: var(--text); font-size: 14px; line-height: 1.35;
  box-shadow: 0 18px 40px -20px rgba(0,0,0,.85);
  -webkit-backdrop-filter: blur(22px) saturate(180%); backdrop-filter: blur(22px) saturate(180%);
  animation: mzSlideDown .42s var(--spring) both;
}
.toast.out { animation: mzFade .3s ease reverse both; }
.toast .t-ico { display: grid; place-items: center; flex: 0 0 auto; color: var(--accent); }
.toast.ok .t-ico   { color: var(--ok); }
.toast.bad .t-ico  { color: var(--red); }
.toast.warn .t-ico { color: var(--amber); }
.toast .t-msg { flex: 1 1 auto; min-width: 0; }
.toast .t-act {
  flex: 0 0 auto; border: 0; cursor: pointer; font: inherit; font-size: 13.5px; font-weight: 600;
  color: var(--accent); background: color-mix(in srgb, var(--accent) 14%, transparent);
  padding: 6px 11px; border-radius: 999px;
}
.toast .t-act:active { transform: scale(.95); }

/* ============================== 数字滚动 / 高亮 ============================== */
.k-value, .num-hero { font-variant-numeric: tabular-nums; }
.tick { animation: mzPop .5s var(--spring) both; }
.flash { animation: mzBlink .6s ease 2; }

/* 奔跑中的小圆点（任务在跑时闪） */
.dot.run, .live-dot {
  width: 8px; height: 8px; border-radius: 999px; display: inline-block;
  background: var(--accent); position: relative; flex: 0 0 auto;
}
.dot.run::after, .live-dot::after {
  content: ''; position: absolute; inset: 0; border-radius: 999px;
  background: var(--accent); animation: mzPulse 1.5s ease-out infinite;
}
/* ============================== 进度环 ============================== */
.ring {
  position: relative; border-radius: 999px; flex: 0 0 auto;
  background:
    conic-gradient(from -90deg,
      var(--ring-tone, var(--accent)) calc(var(--p) * 1%),
      var(--ring-track) 0);
  transition: --p .72s var(--spring);
  box-shadow: 0 0 0 1px var(--ring-line), 0 10px 26px -16px var(--ring-glow, transparent);
}
.ring::before {
  content: ''; position: absolute; inset: 0; border-radius: 999px; pointer-events: none;
  background: radial-gradient(circle at 50% 12%, color-mix(in srgb, var(--ring-tone, var(--accent)) 26%, transparent), transparent 62%);
  opacity: .9;
}
.ring-in {
  position: absolute; inset: 5.5px; border-radius: 999px;
  background: var(--ring-in-bg);
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1px;
  -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
}
.ring-in b { font-size: 1.06em; font-weight: 680; letter-spacing: -.4px; }
.ring-in small { font-size: .62em; color: var(--muted); }
.ring-ico { color: var(--ring-tone, var(--accent)); display: grid; place-items: center; margin-bottom: 1px; }
.ring.thin { background: conic-gradient(from -90deg, var(--ring-tone, var(--accent)) calc(var(--p) * 1%), transparent 0); }
.ring.thin .ring-in { inset: 4px; background: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; }
.ring.warn { --ring-tone: var(--amber); }
.ring.bad  { --ring-tone: var(--red); }
.ring.ok   { --ring-tone: var(--ok); }
.ring.beat::after {
  content: ''; position: absolute; inset: -3px; border-radius: 999px;
  border: 1.6px solid color-mix(in srgb, var(--ring-tone, var(--accent)) 46%, transparent);
  animation: mzBreath 2.2s ease-in-out infinite;
}

/* ============================== 进度条 ============================== */
.bar {
  position: relative; height: 7px; border-radius: 999px; overflow: hidden;
  background: var(--bar-track);
}
.bar-fill {
  height: 100%; border-radius: 999px; width: 0;
  background: linear-gradient(90deg, var(--accent2), var(--accent));
  transition: width .58s var(--spring);
  position: relative;
}
.bar-fill::after {
  content: ''; position: absolute; inset: 0;
  background-image: linear-gradient(115deg, rgba(255,255,255,.24) 25%, transparent 25%, transparent 50%, rgba(255,255,255,.24) 50%, rgba(255,255,255,.24) 75%, transparent 75%);
  background-size: 34px 34px; animation: mzStripe 1s linear infinite; opacity: .55;
}
.bar-fill.warn { background: linear-gradient(90deg, #f2c46b, var(--amber)); }
.bar-fill.bad  { background: linear-gradient(90deg, #ff9a90, var(--red)); }
.bar-fill.ok   { background: linear-gradient(90deg, #63e3b3, var(--ok)); }
.bar.slim { height: 3px; }
.bar.fat { height: 11px; }
.bar.flat .bar-fill::after { animation: none; opacity: .3; }

/* ============================== 标签 chip ============================== */
.chip { animation: mzPop .34s var(--spring) both; }
.chip svg { width: 13px; height: 13px; flex: 0 0 auto; opacity: .95; }
.chip.ok   { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ok) 34%, transparent); }
.chip.warn { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--amber) 34%, transparent); }
.chip.bad  { box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--red) 34%, transparent); }

/* ============================== 下拉刷新 ============================== */
.pull {
  height: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; gap: 8px;
  color: var(--muted); font-size: 13px;
  transition: height .34s var(--spring);
}
.pull-spin { display: grid; place-items: center; transition: transform .3s ease; color: var(--accent); }
.pull.ready .pull-spin { transform: rotate(180deg); }
.pull.ready .pull-txt { color: var(--text); font-weight: 600; }
.pull.busy .pull-spin { animation: mzSpin .8s linear infinite; }

/* ============================== 遮罩 / 抽屉 / 弹窗 ============================== */
.mask {
  position: fixed; inset: 0; z-index: 50; display: flex;
  align-items: flex-end; justify-content: center;
  background: var(--scrim); opacity: 0; transition: opacity .3s ease;
  -webkit-backdrop-filter: blur(0px); backdrop-filter: blur(0px);
}
.mask.on { opacity: 1; -webkit-backdrop-filter: blur(16px) saturate(140%); backdrop-filter: blur(16px) saturate(140%); }
.mask.hidden { display: none; }

.sheet, .actionsheet, .modalbox { will-change: transform, opacity; }
.mask .sheet, .mask .actionsheet {
  transform: translate3d(0, 100%, 0);
  transition: transform .42s var(--spring);
}
.mask.on .sheet, .mask.on .actionsheet { transform: none; }
.mask .modalbox { transform: scale(.9); opacity: 0; transition: transform .34s var(--spring), opacity .24s ease; }
.mask.on .modalbox { transform: none; opacity: 1; }

/* ============================== 底栏 ============================== */
.tabbar { --tab-i: 0; }
.tab-ind {
  position: absolute; top: 0; left: 0; height: 100%; width: 20%;
  transform: translate3d(calc(var(--tab-i) * 100%), 0, 0);
  transition: transform .42s var(--spring);
  pointer-events: none;
}
.tab-ind i {
  position: absolute; top: 3px; left: 50%; width: 26px; height: 3px; margin-left: -13px;
  border-radius: 999px; background: linear-gradient(90deg, var(--accent2), var(--accent));
  box-shadow: 0 0 14px -2px var(--accent);
}
.tab.on .tb-ico { animation: mzPop .42s var(--spring) both; }
.tab.on b { letter-spacing: .2px; }
.tab .tbadge { animation: mzPop .3s var(--spring) both; }

/* ============================== 灵动岛停靠条 ============================== */
.islanddock { animation: mzSlideDown .5s var(--spring) both; }
.islanddock .id-dot { position: relative; background: var(--accent); }
.islanddock .id-dot::after {
  content: ''; position: absolute; inset: 0; border-radius: 999px;
  background: var(--accent); animation: mzPulse 1.5s ease-out infinite;
}
.islanddock .id-track i {
  background: linear-gradient(90deg, var(--accent2), var(--accent));
  transition: width .6s var(--spring);
  box-shadow: 0 0 12px -1px var(--accent);
}

/* ============================== 实时进度：正在跑什么 ============================== */
/* 跑动中的卡片：顶部一条流动光带 */
.running-card { position: relative; overflow: hidden; }
.running-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  background-size: 45% 100%; background-repeat: no-repeat;
  animation: mzTrack 1.5s ease-in-out infinite;
}
@keyframes mzTrack {
  0%   { background-position: -50% 0; }
  100% { background-position: 150% 0; }
}
.running-card .live-dot { animation: mzBreath 1.4s ease-in-out infinite; }

/* 事件流：新的一条从下面浮上来 */
.ev { animation: mzRise .4s var(--spring) both; }
.ev-list > .ev:nth-child(1) { --i: 0; }
.ev-list > .ev:nth-child(2) { --i: 1; }
.ev-list > .ev:nth-child(3) { --i: 2; }
.ev-list > .ev:nth-child(4) { --i: 3; }

/* 阶段步骤条：当前那一步在呼吸 */
.step { transition: color .3s ease, background-color .3s ease, border-color .3s ease; }
.step.on .st-dot {
  background: var(--accent); color: #06120d; border-color: transparent;
  animation: mzBreath 1.5s ease-in-out infinite;
}
.step.on { color: var(--text); font-weight: 600; }
.step.done .st-dot { background: color-mix(in srgb, var(--ok) 22%, transparent); color: var(--ok); border-color: color-mix(in srgb, var(--ok) 40%, transparent); }

/* 阶段文字跑马灯（长文案横着滚，不换行不跳动） */
.marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
.marquee > i { display: inline-flex; white-space: nowrap; font-style: normal; animation: mzMarquee 14s linear infinite; }

/* 队列小条：正在调用哪个模型 */
.qbar { display: flex; gap: 6px; overflow: hidden; }
.qslot {
  flex: 0 0 auto; display: flex; align-items: center; gap: 6px; padding: 5px 9px; border-radius: 999px;
  font-size: 11.5px; background: var(--panel2); border: 1px solid var(--line-soft); color: var(--muted);
  animation: mzPop .34s var(--spring) both;
}
.qslot.hot { color: var(--text); border-color: color-mix(in srgb, var(--accent) 42%, transparent); background: color-mix(in srgb, var(--accent) 10%, transparent); }

/* 保存状态点：有未保存修改时呼吸提醒 */
.save-dot.dirty { animation: mzBreath 1.1s ease-in-out infinite; }

/* 新章节写完后冒出的星点 */
.spark { position: absolute; pointer-events: none; color: var(--accent); animation: mzSpark 1.1s ease-out forwards; }

/* ============================== 启动页 ============================== */
.splash img { animation: mzBreath 2.6s ease-in-out infinite; }
.splash { transition: opacity .38s ease, transform .38s ease; }
.splash.gone { opacity: 0; transform: scale(1.04); pointer-events: none; }

/* ============================== 空状态 ============================== */
.empty .em-ico { animation: mzRise .5s var(--spring) both; }
.empty .em-t { animation: mzRise .5s var(--spring) .06s both; }
.empty .em-s { animation: mzRise .5s var(--spring) .12s both; }

/* ============================== 减弱动态效果 ============================== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001ms !important;
    scroll-behavior: auto !important;
  }
  .rise, .ev, .toast, .screen-fade, .screen-push, .screen-back, .islanddock { animation: none !important; }
  .aurora { animation: none !important; }
}
